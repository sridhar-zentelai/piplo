{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piplo",
  "version": "0.1.0",
  "identifier": "com.codea.piplo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "url": "index.html",
        "title": "Piplo",
        "width": 56,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "menu",
        "url": "index.html",
        "title": "Piplo menu",
        "width": 212,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "home",
        "url": "index.html",
        "title": "Piplo",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
