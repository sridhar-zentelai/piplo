# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. Used for both transcription and grammar.
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Override the grammar model id if the default has been retired.
# Default: llama-3.3-70b-versatile
PIPLO_GRAMMAR_MODEL=

# Optional. Set to 0 to bypass grammar correction entirely (debugging only).
PIPLO_GRAMMAR=
